# Production site URL (no trailing slash). Used for canonicals, sitemap, OG, JSON-LD.
SITE_URL=https://yourdomain.com

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools verification token
BING_SITE_VERIFICATION=

# Optional: Web3Forms access key (https://web3forms.com) for contact/careers forms.
# This key is designed to be public (browser-side). If unset, forms use FormSubmit.
PUBLIC_WEB3FORMS_KEY=

# Contact form recipient (used by public/api/contact.php on Hostinger)
CONTACT_TO_EMAIL=gultajkhan980@gmail.com

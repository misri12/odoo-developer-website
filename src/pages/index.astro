---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFlow from '../components/HeroFlow.astro';
import TechStrip from '../components/TechStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IntegrationsSection from '../components/IntegrationsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import { brand, faqs, problems, processSteps, services, whyPoints } from '../data/site';
import { projects } from '../data/projects';
import { odooApps } from '../data/apps';
import { pagesSeo } from '../data/seo';
import { faqJsonLd, personJsonLd, webpageJsonLd, websiteJsonLd } from '../utils/schema';

const seo = pagesSeo.home;
const featured = projects.slice(0, 6);
import { p } from '../utils/paths';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  ogImage={seo.ogImage}
  jsonLd={[websiteJsonLd(), personJsonLd(), webpageJsonLd({ name: seo.title, description: seo.description, path: seo.path }), faqJsonLd(faqs)]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__atmosphere" aria-hidden="true">
      <div class="hero__blob hero__blob--1"></div>
      <div class="hero__blob hero__blob--2"></div>
      <div class="hero__grid-pattern"></div>
    </div>
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="hero__brand hero-enter hero-enter--1">{brand.name}</p>
        <p class="hero__role hero-enter hero-enter--2">{brand.title}</p>
        <h1 id="hero-title" class="hero-enter hero-enter--3">
          Custom Odoo Solutions That <span class="text-gradient">Connect Your Business</span>.
        </h1>
        <p class="hero__lead hero-enter hero-enter--4">
          Odoo development, eCommerce integrations and ERP automation built around the way your business actually works.
        </p>
        <div class="hero__actions hero-enter hero-enter--5">
          <a class="btn btn--primary" href={p('/contact')}>Discuss Your Project</a>
          <a class="btn btn--secondary" href={p('/projects')}>View My Work</a>
        </div>
        <p class="hero__note hero-enter hero-enter--6">{brand.locationFocus}</p>
      </div>
      <div class="hero__visual hero-enter hero-enter--5">
        <HeroFlow />
      </div>
    </div>
  </section>

  <TechStrip />

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section__header reveal">
        <p class="section__eyebrow">Services</p>
        <h2 class="section__title" id="services-title">Odoo development and integration services</h2>
        <p class="section__lead">
          From custom modules to storefront sync — focused work for businesses, agencies and ERP implementation partners.
        </p>
      </div>
      <div class="grid-4">
        {
          services.map((service) => (
            <ServiceCard
              href={service.href}
              title={service.title}
              description={service.description}
              icon={service.icon}
            />
          ))
        }
      </div>
    </div>
  </section>

  <IntegrationsSection />

  <section class="section" aria-labelledby="problems-title">
    <div class="container">
      <div class="section__header reveal">
        <p class="section__eyebrow">Problem → Solution</p>
        <h2 class="section__title" id="problems-title">Fix the operational friction, not just the feature list</h2>
        <p class="section__lead">
          Most Odoo and integration projects start with a broken process. Here is how those problems typically get solved.
        </p>
      </div>
      <div class="problem-grid">
        {
          problems.map((item) => (
            <article class="problem-card reveal">
              <h3>{item.problem}</h3>
              <p><span class="problem-card__arrow" aria-hidden="true">→</span> {item.solution}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="projects-title">
    <div class="container">
      <div class="section__header reveal">
        <p class="section__eyebrow">Featured work</p>
        <h2 class="section__title" id="projects-title">Projects that connect systems and workflows</h2>
        <p class="section__lead">
          Real packaged modules and connectors. Outcomes describe shipped software — not invented client revenue.
        </p>
      </div>
      <div class="grid-3">
        {
          featured.map((project) => (
            <article class="card project-card reveal">
              {project.placeholder && (
                <span class="badge">Project details available on request</span>
              )}
              <h3 class="card__title">{project.name}</h3>
              <p class="card__text"><strong>Problem:</strong> {project.problem}</p>
              <p class="card__text"><strong>Solution:</strong> {project.solution}</p>
              <p class="card__text"><strong>Technology:</strong> {project.technology.join(', ')}</p>
              <p class="card__text"><strong>Outcome:</strong> {project.outcome}</p>
              {project.href ? (
                <a class="card__link" href={p(project.href)}>View project details →</a>
              ) : (
                <a class="card__link" href={p('/projects')}>View all projects →</a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section__header reveal">
        <p class="section__eyebrow">Process</p>
        <h2 class="section__title" id="process-title">A clear path from brief to production</h2>
      </div>
      <ol class="process">
        {
          processSteps.map((step) => (
            <li class="process__item reveal">
              <div class="process__marker">
                <span class="process__step">{step.step}</span>
              </div>
              <div class="process__body">
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="apps-title">
    <div class="container">
      <div class="section__header reveal">
        <p class="section__eyebrow">Odoo Apps</p>
        <h2 class="section__title" id="apps-title">Packaged modules for Odoo Website &amp; eCommerce</h2>
      </div>
      <div class="grid-2">
        {
          odooApps.map((app) => (
            <article class="card app-card reveal">
              <div class="app-card__icon">
                <img
                  src={p(app.icon)}
                  alt={`${app.name} icon`}
                  width="64"
                  height="64"
                  loading="lazy"
                />
              </div>
              <div>
                <p class="badge">{app.version} · {app.category}</p>
                <h3 class="card__title">{app.name}</h3>
                <p class="card__text">{app.shortDescription}</p>
                <a class="card__link" href={p(app.href)}>View App →</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="section__header reveal">
        <p class="section__eyebrow">Why work with me</p>
        <h2 class="section__title" id="why-title">Practical Odoo engineering for international teams</h2>
      </div>
      <div class="grid-3">
        {
          whyPoints.map((point) => (
            <article class="card card--static reveal">
              <h3 class="card__title">{point.title}</h3>
              <p class="card__text">{point.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <FinalCta />
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + 2.5rem) 0 4rem;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.55;
    animation: hero-blob 14s ease-in-out infinite alternate;
  }

  .hero__blob--1 {
    width: min(52vw, 420px);
    height: min(52vw, 420px);
    top: -8%;
    left: -6%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.45), transparent 70%);
  }

  .hero__blob--2 {
    width: min(48vw, 380px);
    height: min(48vw, 380px);
    right: -4%;
    bottom: 5%;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.28), transparent 70%);
    animation-delay: -6s;
    animation-duration: 18s;
  }

  .hero__grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(148, 163, 184, 0.18) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 75% 65% at 40% 35%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 40% 35%, #000 20%, transparent 75%);
    opacity: 0.45;
  }

  @keyframes hero-blob {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(24px, 18px) scale(1.08);
    }
  }

  .hero__grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }

  .hero__brand {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .hero__role {
    margin: 0.35rem 0 1.15rem;
    color: var(--accent);
    font-weight: 650;
    font-size: 0.98rem;
  }

  .hero h1 {
    margin: 0 0 1.15rem;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 5vw, 3.55rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--ink);
  }

  .hero__lead {
    margin: 0 0 1.75rem;
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__note {
    margin: 1.35rem 0 0;
    color: var(--muted-2);
    font-size: 0.92rem;
  }

  .hero-enter {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-fade-up 0.7s var(--ease) forwards;
  }

  .hero-enter--1 {
    animation-delay: 0.05s;
  }

  .hero-enter--2 {
    animation-delay: 0.12s;
  }

  .hero-enter--3 {
    animation-delay: 0.2s;
  }

  .hero-enter--4 {
    animation-delay: 0.3s;
  }

  .hero-enter--5 {
    animation-delay: 0.4s;
  }

  .hero-enter--6 {
    animation-delay: 0.5s;
  }

  @keyframes hero-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__blob {
      animation: none;
    }

    .hero-enter {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .problem-grid {
    display: grid;
    gap: 1rem;
  }

  .problem-card {
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background:
      linear-gradient(165deg, rgba(255, 255, 255, 0.04), transparent 50%),
      var(--bg-elevated);
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .problem-card:hover {
    border-color: rgba(56, 189, 248, 0.45);
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }

  .problem-card h3 {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
  }

  .problem-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .problem-card__arrow {
    color: var(--accent);
    font-weight: 700;
  }

  .process {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
  }

  /* Vertical connector (mobile) */
  .process::before {
    content: '';
    position: absolute;
    top: 1.35rem;
    bottom: 1.35rem;
    left: 1.35rem;
    width: 2px;
    background: linear-gradient(
      180deg,
      rgba(56, 189, 248, 0.55),
      rgba(56, 189, 248, 0.12) 50%,
      rgba(56, 189, 248, 0.35)
    );
    border-radius: 2px;
  }

  .process__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.15rem;
    align-items: start;
    padding: 0 0 1.75rem;
    border: none;
    background: transparent;
  }

  .process__item:last-child {
    padding-bottom: 0;
  }

  .process__marker {
    position: relative;
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .process__step {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    border-radius: 0.85rem;
    border: 1px solid rgba(56, 189, 248, 0.35);
    background:
      linear-gradient(145deg, rgba(56, 189, 248, 0.18), rgba(14, 165, 233, 0.06)),
      var(--bg-elevated);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.12);
  }

  .process__body {
    padding: 0.85rem 1.1rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(165deg, rgba(255, 255, 255, 0.04), transparent 50%),
      var(--bg-elevated);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .process__item:hover .process__body {
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }

  .process__item:hover .process__step {
    border-color: rgba(56, 189, 248, 0.65);
    background: linear-gradient(145deg, #0c4a6e, #38bdf8);
    color: #0b1220;
    box-shadow: 0 0 24px rgba(56, 189, 248, 0.35);
  }

  .process__body h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
  }

  .process__body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .app-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.15rem;
    align-items: start;
  }

  .app-card__icon {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 0.85rem;
    background: var(--accent-soft);
    border: 1px solid rgba(56, 189, 248, 0.2);
    overflow: hidden;
    flex-shrink: 0;
  }

  .app-card__icon img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .project-card .badge {
    margin-bottom: 0.75rem;
  }

  .project-card .card__text strong {
    color: var(--ink-soft);
    font-weight: 650;
  }

  @media (min-width: 640px) {
    .problem-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }

    .process {
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
    }

    /* Horizontal connector (desktop) */
    .process::before {
      top: 1.35rem;
      bottom: auto;
      left: 8%;
      right: 8%;
      width: auto;
      height: 2px;
      background: linear-gradient(
        90deg,
        rgba(56, 189, 248, 0.15),
        rgba(56, 189, 248, 0.55) 20%,
        rgba(56, 189, 248, 0.55) 80%,
        rgba(56, 189, 248, 0.15)
      );
    }

    .process__item {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 0 0.4rem;
      gap: 1rem;
    }

    .process__body {
      text-align: left;
      width: 100%;
      min-height: 9.5rem;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCta from '../components/FinalCta.astro';
import { pagesSeo } from '../data/seo';
import { breadcrumbJsonLd, serviceJsonLd, webpageJsonLd } from '../utils/schema';

const seo = pagesSeo.shopify;
import { p } from '../utils/paths';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  ogImage={seo.ogImage}
  jsonLd={[
    webpageJsonLd({ name: seo.title, description: seo.description, path: seo.path }),
    serviceJsonLd({ name: 'Shopify Odoo Integration', description: seo.description, path: seo.path }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'eCommerce Integrations', path: '/ecommerce-integrations' },
      { name: 'Shopify ↔ Odoo', path: seo.path },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'eCommerce Integrations', href: '/ecommerce-integrations' },
          { name: 'Shopify ↔ Odoo' },
        ]}
      />
      <h1 class="page-hero__title">{seo.h1}</h1>
      <p class="page-hero__lead">
        Connect Shopify to Odoo so catalog, stock and orders stay aligned — with sync design that operations teams can trust.
      </p>
      <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.75rem;">
        <a class="btn btn--primary" href={p('/contact')}>Discuss Your Project</a>
        <a class="btn btn--secondary" href={p('/ecommerce-integrations')}>All eCommerce integrations</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <h2>Shopify ↔ Odoo problems this addresses</h2>
      <ul>
        <li>Orders re-entered manually into Odoo</li>
        <li>Inventory differing between Shopify and ERP</li>
        <li>Product/variant updates that do not stay in sync</li>
        <li>Fragile connectors that fail without clear logging</li>
      </ul>
      <h2>Typical synchronization scope</h2>
      <ul>
        <li>Products and variants</li>
        <li>Inventory quantities</li>
        <li>Orders and fulfillment-related updates</li>
        <li>Customers</li>
        <li>Taxes and payment-related data where the process requires it</li>
      </ul>
      <h2>How the work is approached</h2>
      <p>
        Integration work starts with your systems map: what is the source of truth for catalog and stock, which order states matter, and how exceptions should be handled. From there, APIs and Odoo models are wired with validation, retries and operational visibility.
      </p>
      <p>
        Related pages: <a href={p('/woocommerce-odoo-integration')}>WooCommerce ↔ Odoo</a>,
        <a href={p('/amazon-odoo-integration')}>Amazon ↔ Odoo</a>,
        <a href={p('/api-erp-integrations')}>API &amp; ERP integrations</a>.
      </p>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

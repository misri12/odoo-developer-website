---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCta from '../../components/FinalCta.astro';
import { getAppBySlug, odooApps } from '../../data/apps';
import { brand } from '../../data/site';
import { breadcrumbJsonLd, softwareApplicationJsonLd, webpageJsonLd } from '../../utils/schema';

export function getStaticPaths() {
  return odooApps.map((app) => ({ params: { slug: app.slug } }));
}

const { slug } = Astro.params;
const app = getAppBySlug(slug!);
if (!app) {
  throw new Error(`Unknown Odoo app slug: ${slug}`);
}

const title = `${app.name} | Odoo App | ${brand.name}`;
const description = app.shortDescription;
const path = app.href;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage={app.banner || app.icon}
  ogType="article"
  jsonLd={[
    webpageJsonLd({ name: title, description, path }),
    softwareApplicationJsonLd({
      name: app.name,
      description: app.shortDescription,
      path,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Odoo',
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Odoo Apps', path: '/odoo-apps' },
      { name: app.name, path },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Odoo Apps', href: '/odoo-apps' },
          { name: app.name },
        ]}
      />
      <div class="app-hero">
        <img src={app.icon} alt={`${app.name} icon`} width="88" height="88" />
        <div>
          <p class="badge">{app.version} · {app.category}</p>
          <h1 class="page-hero__title">{app.name}</h1>
          <p class="page-hero__lead">{app.shortDescription}</p>
          <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.75rem;">
            <a class="btn btn--primary" href="/contact">Discuss Your Project</a>
            {
              app.github && (
                <a class="btn btn--secondary" href={app.github} target="_blank" rel="noopener noreferrer">
                  View on GitHub
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      {
        app.banner && (
          <img
            class="app-banner"
            src={app.banner}
            alt={`${app.name} banner`}
            width="1200"
            height="400"
            loading="lazy"
          />
        )
      }
      <div class="prose" style="margin-top:2rem;">
        <h2>About this Odoo App</h2>
        <p>{app.description}</p>
        <h3>Capabilities</h3>
        <ul>
          {app.features.map((feature) => <li>{feature}</li>)}
        </ul>
        {
          app.relatedServices && app.relatedServices.length > 0 && (
            <>
              <h3>Related services</h3>
              <ul>
                {app.relatedServices.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
                <li>
                  <a href="/odoo-apps">All Odoo Apps</a>
                </li>
                <li>
                  <a href="/projects">Projects</a>
                </li>
              </ul>
            </>
          )
        }
      </div>
      {
        app.hero && (
          <img
            class="app-banner"
            style="margin-top:2rem;"
            src={app.hero}
            alt={`${app.name} screenshot`}
            width="1200"
            height="675"
            loading="lazy"
          />
        )
      }
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .app-hero {
    display: grid;
    gap: 1.25rem;
  }

  .app-hero img {
    border-radius: 18px;
  }

  .app-banner {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 720px) {
    .app-hero {
      grid-template-columns: 88px 1fr;
      align-items: start;
    }
  }
</style>

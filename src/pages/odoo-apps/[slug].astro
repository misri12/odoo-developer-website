---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCta from '../../components/FinalCta.astro';
import { getAppBySlug, odooApps } from '../../data/apps';
import { brand } from '../../data/site';
import { breadcrumbJsonLd, softwareApplicationJsonLd, webpageJsonLd } from '../../utils/schema';
import { p } from '../../utils/paths';

export function getStaticPaths() {
  return odooApps.map((app) => ({ params: { slug: app.slug } }));
}

const { slug } = Astro.params;
const app = getAppBySlug(slug!);
if (!app) {
  throw new Error(`Unknown Odoo app slug: ${slug}`);
}

const title = `${app.name} | Odoo App | ${brand.name}`;
const description = app.shortDescription;
const path = app.href;
const hasScreenshots = Boolean(app.screenshots && app.screenshots.length > 0);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage={app.banner || app.hero || app.icon}
  ogType="article"
  jsonLd={[
    webpageJsonLd({ name: title, description, path }),
    softwareApplicationJsonLd({
      name: app.name,
      description: app.shortDescription,
      path,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Odoo',
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Odoo Apps', path: '/odoo-apps' },
      { name: app.name, path },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Odoo Apps', href: '/odoo-apps' },
          { name: app.name },
        ]}
      />
      <div class="app-hero">
        <img src={p(app.icon)} alt={`${app.name} icon`} width="88" height="88" />
        <div>
          <div class="app-tags">
            <span class="badge">{app.version}</span>
            <span class="badge">{app.category}</span>
          </div>
          <h1 class="page-hero__title">{app.name}</h1>
          <p class="page-hero__lead">{app.shortDescription}</p>
          <div class="app-actions">
            <a class="btn btn--primary" href={p('/contact')}>Discuss Your Project</a>
            {
              app.github && (
                <a class="btn btn--secondary" href={app.github} target="_blank" rel="noopener noreferrer">
                  View on GitHub
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container app-detail">
      {
        app.banner && (
          <figure class="app-media">
            <img
              class="app-banner"
              src={p(app.banner)}
              alt={`${app.name} banner`}
              width="1200"
              height="400"
              loading="eager"
            />
          </figure>
        )
      }

      <div class="prose">
        <h2>About this Odoo App</h2>
        <p>{app.description}</p>
        {
          app.details && app.details.length > 0 && (
            <ul class="app-details">
              {app.details.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }

        <h3>Capabilities</h3>
        <ul>
          {app.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>

      {
        app.hero && (
          <figure class="app-media">
            <img
              class="app-banner"
              src={p(app.hero)}
              alt={`${app.name} product screenshot`}
              width="1200"
              height="675"
              loading="lazy"
            />
            <figcaption>Product overview — {app.name}</figcaption>
          </figure>
        )
      }

      {
        hasScreenshots && (
          <div class="app-gallery">
            <h2>Product screenshots</h2>
            <p class="app-gallery__lead">
              Screens from the installed module — configuration, sync operations and day-to-day workflows.
            </p>
            <div class="app-gallery__grid">
              {app.screenshots!.map((shot) => (
                <figure class="app-shot">
                  <img src={p(shot.src)} alt={shot.alt} width="800" height="500" loading="lazy" />
                  {shot.caption && <figcaption>{shot.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        )
      }

      {
        app.relatedServices && app.relatedServices.length > 0 && (
          <div class="prose related">
            <h3>Related services</h3>
            <ul>
              {app.relatedServices.map((link) => (
                <li>
                  <a href={p(link.href)}>{link.label}</a>
                </li>
              ))}
              <li>
                <a href={p('/odoo-apps')}>All Odoo Apps</a>
              </li>
              <li>
                <a href={p('/projects')}>Projects</a>
              </li>
            </ul>
          </div>
        )
      }
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .app-hero {
    display: grid;
    gap: 1.25rem;
  }

  .app-hero img {
    border-radius: 18px;
    border: 1px solid var(--border);
    background: #fff;
  }

  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .app-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .app-detail {
    display: grid;
    gap: 2rem;
  }

  .app-media {
    margin: 0;
  }

  .app-banner {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    display: block;
  }

  .app-media figcaption,
  .app-shot figcaption {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .app-details {
    margin: 1rem 0 0;
  }

  .app-gallery h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
  }

  .app-gallery__lead {
    margin: 0 0 1.25rem;
    color: var(--muted);
    max-width: 48rem;
  }

  .app-gallery__grid {
    display: grid;
    gap: 1.25rem;
  }

  .app-shot {
    margin: 0;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .app-shot img {
    width: 100%;
    height: auto;
    display: block;
    vertical-align: middle;
  }

  .app-shot figcaption {
    padding: 0 1rem 1rem;
  }

  .related {
    margin-top: 0.5rem;
  }

  @media (min-width: 720px) {
    .app-hero {
      grid-template-columns: 88px 1fr;
      align-items: start;
    }

    .app-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

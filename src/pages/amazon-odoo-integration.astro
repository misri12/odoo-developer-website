---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCta from '../components/FinalCta.astro';
import { pagesSeo } from '../data/seo';
import { breadcrumbJsonLd, serviceJsonLd, webpageJsonLd } from '../utils/schema';

const seo = pagesSeo.amazon;
import { p } from '../utils/paths';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  ogImage={seo.ogImage}
  jsonLd={[
    webpageJsonLd({ name: seo.title, description: seo.description, path: seo.path }),
    serviceJsonLd({ name: 'Amazon Odoo Integration', description: seo.description, path: seo.path }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'eCommerce Integrations', path: '/ecommerce-integrations' },
      { name: 'Amazon ↔ Odoo', path: seo.path },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'eCommerce Integrations', href: '/ecommerce-integrations' },
          { name: 'Amazon ↔ Odoo' },
        ]}
      />
      <h1 class="page-hero__title">{seo.h1}</h1>
      <p class="page-hero__lead">
        Connect Amazon marketplace flows to Odoo for listings, inventory, orders and fulfillment-related operational data.
      </p>
      <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.75rem;">
        <a class="btn btn--primary" href={p('/contact')}>Discuss Your Project</a>
        <a class="btn btn--secondary" href={p('/ecommerce-integrations')}>All eCommerce integrations</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <h2>Amazon ↔ Odoo scope</h2>
      <ul>
        <li>Listing and catalog-related data flows</li>
        <li>Inventory synchronization to reduce oversell risk</li>
        <li>Order intake into Odoo sales and warehouse processes</li>
        <li>Fulfillment-related status updates where required</li>
      </ul>
      <h2>Design considerations</h2>
      <p>
        Marketplace integrations need careful mapping of SKUs, warehouses, fees and status transitions. The integration should make failures visible and keep ERP records consistent with marketplace reality.
      </p>
      <p>
        Related: <a href={p('/shopify-odoo-integration')}>Shopify ↔ Odoo</a>,
        <a href={p('/woocommerce-odoo-integration')}>WooCommerce ↔ Odoo</a>,
        <a href={p('/api-erp-integrations')}>API &amp; ERP integrations</a>.
      </p>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

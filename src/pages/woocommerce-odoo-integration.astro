---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCta from '../components/FinalCta.astro';
import { pagesSeo } from '../data/seo';
import { breadcrumbJsonLd, serviceJsonLd, webpageJsonLd } from '../utils/schema';

const seo = pagesSeo.woocommerce;
import { p } from '../utils/paths';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  ogImage={seo.ogImage}
  jsonLd={[
    webpageJsonLd({ name: seo.title, description: seo.description, path: seo.path }),
    serviceJsonLd({ name: 'WooCommerce Odoo Integration', description: seo.description, path: seo.path }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'eCommerce Integrations', path: '/ecommerce-integrations' },
      { name: 'WooCommerce ↔ Odoo', path: seo.path },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'eCommerce Integrations', href: '/ecommerce-integrations' },
          { name: 'WooCommerce ↔ Odoo' },
        ]}
      />
      <h1 class="page-hero__title">{seo.h1}</h1>
      <p class="page-hero__lead">
        Connect WooCommerce to Odoo for catalog, stock, order and customer synchronization built around your WordPress store setup.
      </p>
      <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.75rem;">
        <a class="btn btn--primary" href={p('/contact')}>Discuss Your Project</a>
        <a class="btn btn--secondary" href={p('/ecommerce-integrations')}>All eCommerce integrations</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <h2>WooCommerce ↔ Odoo integration focus</h2>
      <ul>
        <li>Product and category synchronization</li>
        <li>Inventory alignment between store and ERP</li>
        <li>Order import into Odoo sales workflows</li>
        <li>Customer record consistency</li>
        <li>Handling of plugins, custom fields and store-specific edge cases</li>
      </ul>
      <h2>Common failure modes</h2>
      <ul>
        <li>Partial syncs after plugin conflicts or API rate limits</li>
        <li>Stock oversell when inventory updates lag</li>
        <li>Order mapping that ignores refunds, cancellations or multi-currency details</li>
      </ul>
      <p>
        Related: <a href={p('/shopify-odoo-integration')}>Shopify ↔ Odoo</a>,
        <a href={p('/api-erp-integrations')}>REST API integrations</a>,
        <a href={p('/odoo-development')}>Odoo development</a>.
      </p>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

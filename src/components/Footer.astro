---
import { brand, footerNav, social } from '../data/site';
import { p } from '../utils/paths';
---

<footer class="site-footer">
  <div class="site-footer__glow" aria-hidden="true"></div>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="logo" href={p('/')}>
        <span class="logo__mark" aria-hidden="true">GK</span>
        <span class="logo__text">
          <span class="logo__name">{brand.name}</span>
          <span class="logo__role">{brand.title}</span>
        </span>
      </a>
      <p>{brand.tagline}</p>
      <div class="site-footer__social">
        <a href={social.github} rel="noopener noreferrer" target="_blank">GitHub</a>
        <a href={social.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        <a href={p('/contact')}>Contact</a>
      </div>
    </div>

    <div>
      <h2 class="site-footer__heading">Services</h2>
      <ul>
        {footerNav.services.map((item) => <li><a href={p(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Integrations</h2>
      <ul>
        {footerNav.integrations.map((item) => <li><a href={p(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Explore</h2>
      <ul>
        {footerNav.company.map((item) => <li><a href={p(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {new Date().getFullYear()} {brand.name}. Odoo development &amp; eCommerce integrations.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 0;
    padding: 4.5rem 0 1.75rem;
    background: #070d18;
    color: #c9d3df;
    overflow: hidden;
  }

  .site-footer__glow {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(56, 189, 248, 0.55) 30%,
      rgba(56, 189, 248, 0.55) 70%,
      transparent
    );
  }

  .site-footer__glow::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(60%, 480px);
    height: 120px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at top, rgba(56, 189, 248, 0.12), transparent 70%);
    pointer-events: none;
  }

  .site-footer a {
    color: #dce5ef;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition:
      color 0.25s var(--ease),
      background-size 0.25s var(--ease);
  }

  .site-footer a:hover {
    color: #fff;
    background-size: 100% 1px;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .site-footer__brand p {
    margin: 1.15rem 0;
    max-width: 28rem;
    color: #8fa0b2;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .logo {
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    background-image: none;
  }

  .logo:hover {
    background-size: 0;
    opacity: 0.92;
  }

  .logo__mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 0.75rem;
    background: linear-gradient(145deg, #0c4a6e, #38bdf8);
    color: #0b1220;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo__name {
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .logo__role {
    font-size: 0.75rem;
    color: #8fa0b2;
  }

  .site-footer__heading {
    margin: 0 0 1rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer li + li {
    margin-top: 0.55rem;
  }

  .site-footer li a {
    font-size: 0.95rem;
    color: #a8b7c8;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    font-weight: 600;
  }

  .site-footer__social a {
    color: var(--accent);
  }

  .site-footer__bottom {
    margin-top: 3rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.9rem;
    color: #6b7c90;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (min-width: 800px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: 2rem 2.5rem;
    }
  }
</style>

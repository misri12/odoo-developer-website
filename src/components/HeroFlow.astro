---
---

<div class="hero-flow" aria-hidden="true">
  <div class="hero-flow__card hero-flow__card--odoo">
    <span class="hero-flow__label">ERP</span>
    <strong>Odoo</strong>
  </div>
  <div class="hero-flow__connector">
    <span></span>
    <small>APIs / Automation</small>
    <span></span>
  </div>
  <div class="hero-flow__platforms">
    <div class="hero-flow__card">Shopify</div>
    <div class="hero-flow__card">WooCommerce</div>
    <div class="hero-flow__card">Amazon</div>
    <div class="hero-flow__card">Tally</div>
  </div>
  <div class="hero-flow__connector">
    <span></span>
    <small>Connected operations</small>
    <span></span>
  </div>
  <div class="hero-flow__card hero-flow__card--ops">
    <span class="hero-flow__label">Outcome</span>
    <strong>Business Operations</strong>
  </div>
</div>

<style>
  .hero-flow {
    display: grid;
    gap: 0.85rem;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(165deg, rgba(56, 189, 248, 0.08), transparent 45%),
      rgba(17, 24, 39, 0.85);
    box-shadow: var(--shadow-lg), 0 0 40px rgba(56, 189, 248, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .hero-flow__card {
    padding: 0.9rem 1rem;
    border-radius: 0.85rem;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
    font-weight: 650;
    text-align: center;
    color: var(--ink-soft);
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .hero-flow__card:hover {
    border-color: rgba(56, 189, 248, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .hero-flow__card--odoo,
  .hero-flow__card--ops {
    background: linear-gradient(145deg, #0c4a6e, #0284c7 55%, #38bdf8);
    border-color: transparent;
    color: #0b1220;
    display: grid;
    gap: 0.15rem;
    box-shadow: 0 8px 28px rgba(56, 189, 248, 0.25);
  }

  .hero-flow__card--odoo:hover,
  .hero-flow__card--ops:hover {
    border-color: transparent;
  }

  .hero-flow__label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
    font-weight: 600;
  }

  .hero-flow__platforms {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .hero-flow__connector {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .hero-flow__connector span {
    width: 1px;
    height: 12px;
    background: linear-gradient(var(--accent), transparent);
  }

  @media (min-width: 768px) {
    .hero-flow {
      padding: 1.6rem;
    }
  }
</style>

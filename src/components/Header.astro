---
import { brand, nav } from '../data/site';
import { p } from '../utils/paths';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="logo" href={p('/')} aria-label={`${brand.name} — home`}>
      <span class="logo__mark" aria-hidden="true">GK</span>
      <span class="logo__text">
        <span class="logo__name">{brand.name}</span>
        <span class="logo__role">Odoo Developer</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li class:list={['nav__item', { 'nav__item--has-children': 'children' in item && !!item.children }]}>
              <a class="nav__link" href={p(item.href)}>
                {item.label}
                {'children' in item && item.children && (
                  <svg class="nav__chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
              {'children' in item && item.children && (
                <ul class="nav__dropdown" aria-label={`${item.label} submenu`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={p(child.href)}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={p('/contact')}>Discuss Your Project</a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          nav.map((item) => (
            <>
              <li>
                <a href={p(item.href)}>{item.label}</a>
              </li>
              {'children' in item &&
                item.children?.map((child) => (
                  <li class="mobile-nav__child">
                    <a href={p(child.href)}>{child.label}</a>
                  </li>
                ))}
            </>
          ))
        }
        <li>
          <a class="btn btn--primary btn--block" href={p('/contact')}>Discuss Your Project</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    background: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      backdrop-filter 0.3s var(--ease);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-md);
  }

  .site-header.is-open {
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
    transition: opacity 0.25s var(--ease);
  }

  .logo:hover {
    opacity: 0.9;
    color: var(--ink);
  }

  .logo__mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 0.75rem;
    background: linear-gradient(145deg, #0c4a6e, var(--accent));
    color: var(--on-accent);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .logo__role {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }

  .nav {
    display: none;
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.8rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 0.75rem;
    transition:
      color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .nav__link:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .nav__chevron {
    opacity: 0.55;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .nav__item--has-children:hover .nav__chevron,
  .nav__item--has-children:focus-within .nav__chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 260px;
    margin: 0;
    padding: 0.55rem;
    list-style: none;
    background: var(--bg-glass);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.98);
    transform-origin: top left;
    transition:
      opacity 0.22s var(--ease),
      transform 0.22s var(--ease),
      visibility 0.22s;
  }

  .nav__item--has-children:hover .nav__dropdown,
  .nav__item--has-children:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .nav__dropdown a {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 0.65rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease),
      padding-left 0.2s var(--ease);
  }

  .nav__dropdown a:hover {
    background: var(--accent-soft);
    color: var(--accent);
    padding-left: 1rem;
  }

  .site-header__cta {
    display: none;
    margin-left: 0.75rem;
    min-height: 42px;
    padding-inline: 1.2rem;
    font-size: 0.92rem;
    border-radius: 999px;
    box-shadow: 0 4px 18px rgba(56, 189, 248, 0.3);
  }

  .nav-toggle {
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition:
      background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .nav-toggle:hover {
    background: var(--accent-soft);
    border-color: rgba(56, 189, 248, 0.35);
  }

  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    display: block;
    width: 18px;
    height: 2px;
    margin: 0 auto;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s var(--ease);
  }

  .nav-toggle__bars {
    position: relative;
  }

  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle__bars::before {
    top: -6px;
  }

  .nav-toggle__bars::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    max-height: calc(100vh - var(--header-h));
    overflow: auto;
    transform: translateY(-8px);
    opacity: 0;
    transition:
      opacity 0.28s var(--ease),
      transform 0.28s var(--ease);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav.is-open {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav ul {
    margin: 0;
    padding: 0.85rem 1rem 1.35rem;
    list-style: none;
  }

  .mobile-nav a {
    display: block;
    padding: 0.8rem 0.35rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 650;
    border-radius: 0.5rem;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .mobile-nav a:hover {
    color: var(--accent);
  }

  .mobile-nav__child a {
    padding-left: 1.1rem;
    font-weight: 550;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .mobile-nav .btn {
    margin-top: 0.85rem;
  }

  @media (min-width: 980px) {
    .nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .nav-toggle,
    .mobile-nav {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav,
    .nav__dropdown,
    .nav__chevron {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const mobileNav = document.querySelector('[data-mobile-nav]');

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setMobileOpen = (open) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    if (!mobileNav) return;
    if (open) {
      mobileNav.hidden = false;
      requestAnimationFrame(() => mobileNav.classList.add('is-open'));
    } else {
      mobileNav.classList.remove('is-open');
      const finish = () => {
        mobileNav.hidden = true;
        mobileNav.removeEventListener('transitionend', finish);
      };
      mobileNav.addEventListener('transitionend', finish);
      window.setTimeout(() => {
        if (!mobileNav.classList.contains('is-open')) mobileNav.hidden = true;
      }, 320);
    }
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setMobileOpen(!open);
  });
</script>

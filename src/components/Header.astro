---
import { brand, nav } from '../data/site';
import { p } from '../utils/paths';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="logo" href={p('/')} aria-label={`${brand.name} — home`}>
      <span class="logo__mark" aria-hidden="true">GK</span>
      <span class="logo__text">
        <span class="logo__name">{brand.name}</span>
        <span class="logo__role">Odoo Developer</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li class:list={['nav__item', { 'nav__item--has-children': !!item.children }]}>
              <a class="nav__link" href={p(item.href)}>
                {item.label}
              </a>
              {item.children && (
                <ul class="nav__dropdown" aria-label={`${item.label} submenu`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={p(child.href)}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={p('/contact')}>Discuss Your Project</a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          nav.map((item) => (
            <>
              <li>
                <a href={p(item.href)}>{item.label}</a>
              </li>
              {item.children?.map((child) => (
                <li class="mobile-nav__child">
                  <a href={p(child.href)}>{child.label}</a>
                </li>
              ))}
            </>
          ))
        }
        <li>
          <a class="btn btn--primary btn--block" href={p('/contact')}>Discuss Your Project</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    background: rgba(244, 246, 248, 0.78);
    backdrop-filter: blur(12px);
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .logo__mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: linear-gradient(145deg, #12343a, #0f6e6a);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .logo__role {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }

  .nav {
    display: none;
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    padding: 0.55rem 0.75rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
  }

  .nav__link:hover {
    color: var(--accent);
    background: rgba(15, 110, 106, 0.06);
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 240px;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      visibility 0.18s;
  }

  .nav__item--has-children:hover .nav__dropdown,
  .nav__item--has-children:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__dropdown a {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .nav__dropdown a:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .site-header__cta {
    display: none;
    margin-left: 0.75rem;
    min-height: 44px;
    padding-inline: 1.1rem;
    font-size: 0.95rem;
  }

  .nav-toggle {
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
  }

  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    display: block;
    width: 18px;
    height: 2px;
    margin: 0 auto;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s var(--ease);
  }

  .nav-toggle__bars {
    position: relative;
  }

  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle__bars::before {
    top: -6px;
  }

  .nav-toggle__bars::after {
    top: 6px;
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: #fff;
    max-height: calc(100vh - var(--header-h));
    overflow: auto;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav ul {
    margin: 0;
    padding: 0.75rem 1rem 1.25rem;
    list-style: none;
  }

  .mobile-nav a {
    display: block;
    padding: 0.75rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 650;
  }

  .mobile-nav__child a {
    padding-left: 1rem;
    font-weight: 550;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .mobile-nav .btn {
    margin-top: 0.75rem;
  }

  @media (min-width: 980px) {
    .nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .nav-toggle,
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const mobileNav = document.querySelector('[data-mobile-nav]');

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    mobileNav?.toggleAttribute('hidden', open);
  });
</script>

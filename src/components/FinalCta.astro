---
import { p } from '../utils/paths';

interface Props {
  title?: string;
  lead?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  dark?: boolean;
  /** Analytics event name for the primary CTA (no PII). */
  primaryTrack?: string;
  /** Analytics event name for the secondary CTA (no PII). */
  secondaryTrack?: string;
  trackLocation?: string;
}

const {
  title = 'Have an Odoo or Integration Project?',
  lead = "Tell me what you're trying to build, automate or integrate.",
  primaryHref = '/contact',
  primaryLabel = 'Discuss Your Project',
  secondaryHref = '/contact#project-form',
  secondaryLabel = 'Send Project Details',
  dark = true,
  primaryTrack = 'cta_project_inquiry',
  secondaryTrack = 'cta_project_details',
  trackLocation = 'final_cta',
} = Astro.props;

const resolve = (href: string) => {
  const [path, hash] = href.split('#');
  const base = p(path || '/');
  return hash ? `${base}#${hash}` : base;
};
---

<section class:list={['final-cta', { 'final-cta--dark': dark }]} aria-labelledby="final-cta-title">
  <div class="container final-cta__inner reveal">
    <h2 id="final-cta-title">{title}</h2>
    <p>{lead}</p>
    <div class="final-cta__actions">
      <a
        class:list={['btn', dark ? 'btn--ghost' : 'btn--primary']}
        href={resolve(primaryHref)}
        data-track={primaryTrack}
        data-track-cta={primaryLabel}
        data-track-location={`${trackLocation}_primary`}>{primaryLabel}</a
      >
      <a
        class:list={['btn', dark ? 'btn--secondary final-cta__secondary' : 'btn--secondary']}
        href={resolve(secondaryHref)}
        data-track={secondaryTrack}
        data-track-cta={secondaryLabel}
        data-track-location={`${trackLocation}_secondary`}
        >{secondaryLabel}</a
      >
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: clamp(4.5rem, 9vw, 6.5rem) 0;
    position: relative;
  }

  .final-cta--dark {
    background:
      radial-gradient(700px 280px at 50% 0%, rgba(56, 189, 248, 0.1), transparent 60%),
      linear-gradient(180deg, var(--bg), var(--bg-deep));
    color: var(--ink);
    border-top: 1px solid var(--border);
  }

  .final-cta__inner {
    text-align: center;
  }

  .final-cta h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ink);
  }

  .final-cta p {
    margin: 0 auto 1.75rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .final-cta__secondary {
    border-color: var(--border-strong);
    color: var(--ink);
  }

  .final-cta__secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--ink);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
</style>

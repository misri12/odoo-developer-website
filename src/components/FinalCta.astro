---
import { p } from '../utils/paths';

interface Props {
  title?: string;
  lead?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  dark?: boolean;
}

const {
  title = 'Have an Odoo or Integration Project?',
  lead = "Tell me what you're trying to build, automate or integrate.",
  primaryHref = '/contact',
  primaryLabel = 'Discuss Your Project',
  secondaryHref = '/contact#project-form',
  secondaryLabel = 'Send Project Details',
  dark = true,
} = Astro.props;

const resolve = (href: string) => {
  const [path, hash] = href.split('#');
  const base = p(path || '/');
  return hash ? `${base}#${hash}` : base;
};
---

<section class:list={['final-cta', { 'final-cta--dark': dark }]} aria-labelledby="final-cta-title">
  <div class="container final-cta__inner reveal">
    <h2 id="final-cta-title">{title}</h2>
    <p>{lead}</p>
    <div class="final-cta__actions">
      <a class:list={['btn', dark ? 'btn--ghost' : 'btn--primary']} href={resolve(primaryHref)}>{primaryLabel}</a>
      <a class:list={['btn', dark ? 'btn--secondary final-cta__secondary' : 'btn--secondary']} href={resolve(secondaryHref)}
        >{secondaryLabel}</a
      >
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: clamp(4.5rem, 9vw, 6.5rem) 0;
    position: relative;
  }

  .final-cta--dark {
    background:
      radial-gradient(700px 280px at 50% 0%, rgba(56, 189, 248, 0.18), transparent 60%),
      linear-gradient(180deg, #0b1220, #070d18);
    color: #fff;
    border-top: 1px solid var(--border);
  }

  .final-cta__inner {
    text-align: center;
  }

  .final-cta h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .final-cta p {
    margin: 0 auto 1.75rem;
    max-width: 34rem;
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .final-cta__secondary {
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }

  .final-cta__secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(56, 189, 248, 0.5);
  }
</style>

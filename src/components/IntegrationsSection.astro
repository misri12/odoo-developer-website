---
import { integrations } from '../data/site';
import { p } from '../utils/paths';
---

<section class="section section--tint" aria-labelledby="integrations-title">
  <div class="container">
    <div class="section__header reveal">
      <p class="section__eyebrow">Integrations</p>
      <h2 class="section__title" id="integrations-title">Different systems. One connected workflow.</h2>
      <p class="section__lead">
        Connect storefronts, marketplaces, accounting tools and APIs to Odoo so operations run from a single source of truth.
      </p>
    </div>

    <div class="integrations">
      <div class="integrations__hub reveal" aria-hidden="true">
        <div class="integrations__core">Odoo</div>
        <div class="integrations__ring"></div>
      </div>

      <ul class="integrations__list">
        {
          integrations.map((item) => (
            <li class="reveal">
              <a class="integrations__item" href={p(item.href)}>
                <span class="integrations__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <path d="M8 12h8M12 8v8" />
                    <circle cx="12" cy="12" r="9" />
                  </svg>
                </span>
                <span class="integrations__name">{item.name}</span>
                <span class="integrations__arrow" aria-hidden="true">↔</span>
                <span class="integrations__odoo">Odoo</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .integrations {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .integrations__hub {
    position: relative;
    width: min(100%, 280px);
    aspect-ratio: 1;
    margin: 0 auto;
    display: grid;
    place-items: center;
  }

  .integrations__core {
    position: relative;
    z-index: 1;
    width: 110px;
    height: 110px;
    display: grid;
    place-items: center;
    border-radius: 1.5rem;
    background: linear-gradient(145deg, #0c4a6e, #0284c7 55%, var(--accent));
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    box-shadow: var(--shadow-lg), 0 0 40px var(--accent-glow);
  }

  .integrations__ring {
    position: absolute;
    inset: 18%;
    border: 1px dashed rgba(56, 189, 248, 0.35);
    border-radius: 50%;
    animation: spin 28s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .integrations__ring {
      animation: none;
    }
  }

  .integrations__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .integrations__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(165deg, rgba(255, 255, 255, 0.05), transparent 50%),
      var(--bg-elevated);
    text-decoration: none;
    color: var(--ink);
    font-weight: 650;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .integrations__item:hover {
    border-color: rgba(56, 189, 248, 0.45);
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
    color: var(--ink);
  }

  .integrations__icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 0.65rem;
    background: var(--accent-soft);
    border: 1px solid rgba(56, 189, 248, 0.2);
    color: var(--accent);
  }

  .integrations__name {
    flex: 1;
  }

  .integrations__arrow {
    color: var(--accent);
  }

  .integrations__odoo {
    color: var(--muted);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .integrations {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
    }
  }
</style>
